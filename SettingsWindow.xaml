<Window x:Class="Distraint.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="640" Height="760" MinWidth="400" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="760">
            <TextBlock Text="Settings" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="Rule changes take effect at the next daily reset. Your very first choice for a setting applies right away. Theme applies at once."
                       TextWrapping="Wrap" Margin="0,6,0,18" Foreground="{DynamicResource SubTextBrush}"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Study" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Minutes to study each day" Margin="0,12,0,4"/>
                    <TextBox x:Name="RequiredBox" Width="120" HorizontalAlignment="Left"/>
                    <TextBlock Text="How study apps count" Margin="0,14,0,6"/>
                    <WrapPanel>
                        <RadioButton x:Name="CombineTotal" GroupName="combine" Content="Combined" Style="{StaticResource Segment}"/>
                        <RadioButton x:Name="CombineEach" GroupName="combine" Content="Individual" Style="{StaticResource Segment}"/>
                    </WrapPanel>
                    <TextBlock Text="Combined: time adds up across all study apps. Individual: every study app needs the full time."
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Unlocking" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Unlock length in minutes (0 = until the next reset)" Margin="0,12,0,4"/>
                    <TextBox x:Name="UnlockBox" Width="120" HorizontalAlignment="Left"/>
                    <TextBlock Text="How unlock time is counted" Margin="0,14,0,6"/>
                    <WrapPanel>
                        <RadioButton x:Name="LimitShared" GroupName="limit" Content="Shared" Style="{StaticResource Segment}"/>
                        <RadioButton x:Name="LimitEach" GroupName="limit" Content="Individual" Style="{StaticResource Segment}"/>
                    </WrapPanel>
                    <TextBlock Text="Shared: one timer for all locked apps. Individual: each locked app gets its own time (needs a timed unlock)."
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/>
                    <TextBlock Text="Daily reset hour (0 to 23)" Margin="0,14,0,4"/>
                    <TextBox x:Name="ResetBox" Width="120" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="When a locked app opens" FontSize="16" FontWeight="SemiBold"/>
                    <WrapPanel Margin="0,12,0,0">
                        <RadioButton x:Name="ActMin" GroupName="action" Content="Minimize it" Style="{StaticResource Segment}"/>
                        <RadioButton x:Name="ActClose" GroupName="action" Content="Close its window" Style="{StaticResource Segment}"/>
                        <RadioButton x:Name="ActKill" GroupName="action" Content="Terminate it" Style="{StaticResource Segment}"/>
                    </WrapPanel>
                    <TextBlock Text="Terminate ends the program immediately, so unsaved game progress is lost."
                               TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Locked apps in the background" FontSize="16" FontWeight="SemiBold"/>
                    <WrapPanel Margin="0,12,0,0">
                        <RadioButton x:Name="BgOff" GroupName="bg" Content="Leave alone" Style="{StaticResource Segment}"/>
                        <RadioButton x:Name="BgClose" GroupName="bg" Content="Close their windows" Style="{StaticResource Segment}"/>
                        <RadioButton x:Name="BgKill" GroupName="bg" Content="Terminate them" Style="{StaticResource Segment}"/>
                    </WrapPanel>
                    <TextBlock Text="What happens to a locked app that is running but not in front. It is given 5 seconds first. Apps that hide in the tray when closed (Discord, LINE) need Terminate. Stricter settings apply at once, looser ones at the next reset."
                   TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SubTextBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold"/>
                    <WrapPanel Margin="0,12,0,0">
                        <RadioButton x:Name="ThemeSystem" GroupName="theme" Content="System" Style="{StaticResource Segment}" Checked="Theme_Checked"/>
                        <RadioButton x:Name="ThemeLight" GroupName="theme" Content="Light" Style="{StaticResource Segment}" Checked="Theme_Checked"/>
                        <RadioButton x:Name="ThemeDark" GroupName="theme" Content="Dark" Style="{StaticResource Segment}" Checked="Theme_Checked"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Sync" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="Share today's study time with your other devices on the same Wi-Fi."
                   TextWrapping="Wrap" Margin="0,6,0,10" Foreground="{DynamicResource SubTextBrush}"/>
                    <CheckBox x:Name="SyncCheck" Content="Turn on sync" Checked="Sync_Changed" Unchecked="Sync_Changed"/>
                    <TextBlock x:Name="SyncStatus" TextWrapping="Wrap" Margin="30,8,0,10" Foreground="{DynamicResource SubTextBrush}"/>
                    <WrapPanel>
                        <Button x:Name="PairButton" Content="Pair a device..." Margin="0,0,8,0" Click="Pair_Click"/>
                        <Button Content="Forget all devices" Click="ForgetSync_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Protection" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="ProtectStatus" TextWrapping="Wrap" Margin="0,8,0,12" Foreground="{DynamicResource SubTextBrush}"/>
                    <Button x:Name="ProtectButton" HorizontalAlignment="Left" Click="Protect_Click"/>
                    <CheckBox x:Name="StartupCheck" Content="Start Distraint with Windows" Margin="0,16,0,0"
                              Checked="Startup_Changed" Unchecked="Startup_Changed"/>
                    <CheckBox x:Name="WatchdogCheck" Content="Restart Distraint automatically if it's closed" Margin="0,12,0,0"
          Checked="Watchdog_Changed" Unchecked="Watchdog_Changed"/>
                    <CheckBox x:Name="AdminCheck" Content="Always run Distraint as administrator" Margin="0,12,0,0"
          Checked="Admin_Changed" Unchecked="Admin_Changed"/>
                    <TextBlock Text="Needed to lock programs that run as administrator (many games). Windows asks for permission each time Distraint starts, except when it starts with Windows."
           TextWrapping="Wrap" FontSize="12" Margin="30,4,0,0" Foreground="{DynamicResource SubTextBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
