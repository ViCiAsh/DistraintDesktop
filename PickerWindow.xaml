<Window x:Class="Distraint.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Choose apps" Width="560" Height="680" MinWidth="380" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="24" FontWeight="Bold"/>
        <TextBlock x:Name="HintText" Grid.Row="1" TextWrapping="Wrap" Margin="0,6,0,12" Foreground="{DynamicResource SubTextBrush}"/>
        <TextBox x:Name="SearchBox" Grid.Row="2" Margin="0,0,0,10" TextChanged="SearchBox_TextChanged"/>
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
            <Grid>
                <TextBlock x:Name="LoadingText" Text="Loading apps…" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource SubTextBrush}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AppList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="4,3" Padding="0,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,10,0"/>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"/>
                                            <TextBlock Text="{Binding Note}" Visibility="{Binding NoteVis}" FontSize="12"
                                                       Foreground="{DynamicResource SubTextBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Button Content="Browse for .exe…" HorizontalAlignment="Left" Click="Browse_Click"/>
            <Button Content="Done" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" Click="Done_Click"/>
        </Grid>
    </Grid>
</Window>
