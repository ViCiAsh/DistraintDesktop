<Window x:Class="Distraint.StrictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Strict lock" Width="600" Height="680" MinWidth="380" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24" MaxWidth="720">
            <TextBlock Text="Strict lock" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="Apps here stay closed during a daily window or a running timer, whatever your study progress. Studying never unlocks them, and a running lock can't be cancelled."
                       TextWrapping="Wrap" Margin="0,6,0,18" Foreground="{DynamicResource SubTextBrush}"/>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Apps" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="AppsSummary" Margin="0,6,0,12" Foreground="{DynamicResource SubTextBrush}"/>
                    <Button Content="Choose apps" HorizontalAlignment="Left" Click="ChooseApps_Click"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Daily windows" FontSize="16" FontWeight="SemiBold"/>
                    <StackPanel x:Name="WindowList" Margin="0,8,0,8"/>
                    <Button Content="Add a window" HorizontalAlignment="Left" Click="AddWindow_Click"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Timer" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TimerStatus" Margin="0,6,0,12" Foreground="{DynamicResource SubTextBrush}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="TimerBox" Width="100" Text="60" Margin="0,0,10,0" VerticalContentAlignment="Center"/>
                        <TextBlock Text="minutes (1 to 10080)" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource SubTextBrush}"/>
                        <Button Content="Start timer" Style="{StaticResource AccentButton}" Click="StartTimer_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
