<Window x:Class="Distraint.TimeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Daily lock window" Width="420" SizeToContent="Height" MinWidth="320"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14">
    <StackPanel Margin="22">
        <TextBlock Text="Daily lock window" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="Your strict-lock apps stay closed between these two times, every day. Use 24-hour time. An end earlier than the start crosses midnight."
                   TextWrapping="Wrap" Margin="0,6,0,16" Foreground="{DynamicResource SubTextBrush}"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Lock starts at" Margin="0,0,0,4"/>
                <TextBox x:Name="StartBox" Text="22:00"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Lock ends at" Margin="0,0,0,4"/>
                <TextBox x:Name="EndBox" Text="06:00"/>
            </StackPanel>
        </Grid>
        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" Margin="0,10,0,0" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Margin="0,0,8,0" Click="Cancel_Click"/>
            <Button Content="Add window" Style="{StaticResource AccentButton}" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
